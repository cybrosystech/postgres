DETAIL:  Key (reversed_entry_id)=(999999) is not present in table "acc_move".
DELETE FROM acc_move WHERE id = 9;					-- ON DELETE SET NULL flows
SELECT reversed_entry_id IS NULL AS set_null_ok FROM acc_move WHERE id = 10;
