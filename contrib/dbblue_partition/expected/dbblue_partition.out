-- Tests for dbblue_partition.  Every scenario here corresponds to a defect
-- of the retired contrib/dbblue_partition C implementation or to a promise
-- in the extension's documentation.  All row dates are fixed so that error
-- messages naming leaf partitions stay stable; "today" tests only check
-- that statements succeed.
CREATE EXTENSION dbblue_partition CASCADE;
NOTICE:  installing required extension "pg_partman"
SET client_min_messages = warning;
-- Error CONTEXT pins PL/pgSQL line numbers and full procedure signatures,
-- which change on any edit to the extension scripts; the messages themselves
-- are what these tests assert.
\set SHOW_CONTEXT never
SET timezone = 'UTC';
-- Refuses to run until explicitly enabled (off by default)
CALL dbblue_partition_model('anything');
ERROR:  dbblue_partition is disabled
HINT:  Run SET dbblue_partition.enabled = on; to enable it for this session.
SET dbblue_partition.enabled = on;
-- ---------------------------------------------------------------------
-- Validation: fail early, before touching anything
-- ---------------------------------------------------------------------
CALL dbblue_partition_model('no_such_table');
ERROR:  table public.no_such_table does not exist
CREATE TABLE val_t (id serial PRIMARY KEY, v text, create_date timestamp);
CALL dbblue_partition_model('val_t', 'no_such_column');
ERROR:  column "no_such_column" of table public.val_t does not exist
CALL dbblue_partition_model('val_t', 'v');				-- wrong type
ERROR:  column "v" has type text, but range partitioning needs date, timestamp or timestamptz
INSERT INTO val_t (v, create_date) VALUES ('x', NULL);
CALL dbblue_partition_model('val_t');					-- NULL in control column
ERROR:  column "create_date" contains 1 NULL value(s) and cannot become the partition key
HINT:  Backfill the column first; it will become part of the primary key.
DELETE FROM val_t;
CREATE TABLE val_nopk (create_date timestamp NOT NULL);
CALL dbblue_partition_model('val_nopk');				-- no primary key
ERROR:  table public.val_nopk has no primary key
DETAIL:  dbblue_partition expects an Odoo-style table with a primary key.
CREATE TABLE val_interval (id serial PRIMARY KEY, create_date timestamp NOT NULL);
CALL dbblue_partition_model('val_interval', 'create_date', '-1 month');
ERROR:  partition interval must be positive, not -1 month
-- ---------------------------------------------------------------------
-- The full Odoo-shaped scenario
-- ---------------------------------------------------------------------
CREATE TABLE res_partner (
    id serial PRIMARY KEY,
    name text UNIQUE,
    create_date timestamp DEFAULT now()
);
CREATE TABLE sale_order (
    id serial PRIMARY KEY,
    name text NOT NULL,
    partner_id integer REFERENCES res_partner(id) ON DELETE RESTRICT,
    company_id integer NOT NULL DEFAULT 1,
    amount numeric CHECK (amount >= 0),
    amount_tax numeric GENERATED ALWAYS AS (amount * 0.1) STORED,
    note text,
    create_date timestamp NOT NULL DEFAULT now(),
    CONSTRAINT sale_order_name_uniq UNIQUE (name),
    CONSTRAINT sale_order_id_company_uniq UNIQUE (id, company_id)
);
CREATE INDEX sale_order_partner_idx ON sale_order (partner_id);
CREATE INDEX sale_order_note_idx ON sale_order (note) WHERE note IS NOT NULL;
CREATE TABLE sale_order_line (
    id serial PRIMARY KEY,
    order_id integer REFERENCES sale_order(id) ON DELETE CASCADE,
    company_id integer,
    qty int,
    CONSTRAINT sol_order_company_fk FOREIGN KEY (order_id, company_id)
        REFERENCES sale_order (id, company_id)
);
CREATE VIEW sale_summary AS
    SELECT partner_id, sum(amount) AS total FROM sale_order GROUP BY partner_id;
CREATE VIEW sale_summary_top AS
    SELECT * FROM sale_summary WHERE total > 100;
CREATE FUNCTION touch_note() RETURNS trigger LANGUAGE plpgsql AS
$$ BEGIN NEW.note := coalesce(NEW.note, 'via-trigger'); RETURN NEW; END $$;
CREATE TRIGGER sale_order_touch BEFORE INSERT ON sale_order
    FOR EACH ROW EXECUTE FUNCTION touch_note();
INSERT INTO res_partner (name, create_date)
    SELECT 'partner ' || g, timestamp '2025-01-01' + (g || ' hours')::interval
    FROM generate_series(1, 50) g;
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    SELECT 'SO' || g, (g % 50) + 1, 1, g % 500,
           timestamp '2025-01-01' + (g || ' minutes')::interval
    FROM generate_series(1, 5000) g;
-- an old outlier, leaving a >1 year hole before the 2025 data
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO-old', 1, 1, 10, timestamp '2023-06-15 12:00:00');
INSERT INTO sale_order_line (order_id, company_id, qty)
    SELECT g, 1, g % 5 FROM generate_series(1, 5000) g;
CALL dbblue_partition_model('sale.order', 'create_date', '1 month');
WARNING:  unique constraint/index "sale_order_name_uniq" on (name) does not include "create_date": it will be enforced per partition, not globally
DETAIL:  PostgreSQL requires every global unique index on a partitioned table to include the partition key.
WARNING:  unique constraint/index "sale_order_id_company_uniq" on (id, company_id) does not include "create_date": it will be enforced per partition, not globally
DETAIL:  PostgreSQL requires every global unique index on a partitioned table to include the partition key.
WARNING:  created unique index sale_order_fkuq1 on (id, company_id, create_date) to back foreign key sol_order_company_fk from public.sale_order_line; uniqueness of (id, company_id) alone is per partition only
WARNING:  foreign key relies on a non-primary unique constraint widened by the partition key
DETAIL:  Uniqueness of the referenced columns is not enforced across partitions, so referential actions may misbehave if duplicates appear.
HINT:  Reference the primary key instead, or include the partition key columns in the foreign key.
-- now partitioned, all rows retained, nothing stranded
SELECT relkind FROM pg_catalog.pg_class WHERE relname = 'sale_order';
 relkind 
---------
 p
(1 row)

SELECT count(*) FROM sale_order;
 count 
-------
  5001
(1 row)

SELECT state, rows_at_conversion, rows_moved, partition_count > 20 AS gapless,
       default_partition_rows, backup_exists, backup_rows_remaining
FROM dbblue_partition_status('sale.order');
  state   | rows_at_conversion | rows_moved | gapless | default_partition_rows | backup_exists | backup_rows_remaining 
----------+--------------------+------------+---------+------------------------+---------------+-----------------------
 complete |               5001 |       5001 | t       |                      0 | t             |                     0
(1 row)

-- writable immediately: today (defect: current month never created) ...
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO-today', 2, 1, 42, now());
-- ... and inside the historical gap (defect: coverage holes)
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO-gap', 2, 1, 42, timestamp '2024-03-03');
-- CHECK constraints survive (defect: silently dropped)
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO-neg', 2, 1, -999, timestamp '2025-01-15');
ERROR:  new row for relation "sale_order_p20250101" violates check constraint "sale_order_amount_check"
DETAIL:  Failing row contains (5004, SO-neg, 2, 1, -999, -99.9, via-trigger, Wed Jan 15 00:00:00 2025).
-- UNIQUE survives, per partition (defect: silently dropped)
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO7', 2, 1, 1, timestamp '2025-01-16');
ERROR:  duplicate key value violates unique constraint "sale_order_p20250101_name_idx"
DETAIL:  Key (name)=(SO7) already exists.
-- generated columns still compute (defect: property lost)
SELECT amount_tax FROM sale_order WHERE name = 'SO-gap';
 amount_tax 
------------
        4.2
(1 row)

-- triggers survive (defect: not carried over)
SELECT note FROM sale_order WHERE name = 'SO-gap';
    note     
-------------
 via-trigger
(1 row)

-- secondary indexes survive on the parent (defect: all dropped)
SELECT indexname FROM pg_indexes
WHERE schemaname = 'public' AND tablename = 'sale_order'
ORDER BY indexname;
       indexname        
------------------------
 sale_order_fkuq1
 sale_order_note_idx
 sale_order_partner_idx
 sale_order_pkey
 sale_order_pklocal
(5 rows)

-- single-column incoming FK still enforced (fixed dates in parent rows)
INSERT INTO sale_order_line (order_id, company_id, qty) VALUES (999999, 1, 1);
ERROR:  insert or update on table "sale_order_line" violates foreign key constraint "sale_order_line_order_id_fkey"
DETAIL:  Key (order_id)=(999999) is not present in table "sale_order".
-- multi-column incoming FK kept composite (defect: decomposed per column)
INSERT INTO sale_order_line (order_id, company_id, qty) VALUES (5, 12345, 1);
ERROR:  insert or update on table "sale_order_line" violates foreign key constraint "sol_order_company_fk"
DETAIL:  Key (order_id, company_id)=(5, 12345) is not present in table "sale_order".
INSERT INTO sale_order_line (order_id, company_id, qty) VALUES (5, 1, 1);
-- outgoing FK still enforced
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO-badpartner', 999999, 1, 5, timestamp '2025-01-17');
ERROR:  insert or update on table "sale_order_p20250101" violates foreign key constraint "sale_order_partner_id_fkey"
DETAIL:  Key (partner_id)=(999999) is not present in table "res_partner".
-- ON DELETE CASCADE flows through the re-pointed FK
DELETE FROM sale_order WHERE name = 'SO5';
SELECT count(*) FROM sale_order_line WHERE order_id = 5;
 count 
-------
     0
(1 row)

-- dependent views recreated and functional (recursively)
SELECT count(*) > 0 FROM sale_summary;
 ?column? 
----------
 t
(1 row)

SELECT count(*) >= 0 FROM sale_summary_top;
 ?column? 
----------
 t
(1 row)

-- serial sequence kept and re-owned: ids continue, no restart
INSERT INTO sale_order (name, partner_id, company_id, amount, create_date)
    VALUES ('SO-seq', 3, 1, 5, timestamp '2025-01-18')
    RETURNING id > 5000 AS id_continues;
 id_continues 
--------------
 t
(1 row)

-- Odoo's unconditional DROP NOT NULL on the partition key: WARNING + no-op
ALTER TABLE sale_order ALTER COLUMN create_date DROP NOT NULL;
WARNING:  ignoring DROP NOT NULL on partition key column "create_date" of relation "sale_order"
DETAIL:  A partition key column must remain NOT NULL because it is part of the partitioned table's primary key.
SELECT attnotnull FROM pg_attribute
WHERE attrelid = 'sale_order'::regclass AND attname = 'create_date';
 attnotnull 
------------
 t
(1 row)

-- 1.3: the primary key stays (id), as a global index
SELECT pg_get_constraintdef(c.oid) AS pk, i.indglobal
FROM pg_constraint c JOIN pg_index i ON i.indexrelid = c.conindid
WHERE c.conrelid = 'sale_order'::regclass AND c.contype = 'p';
        pk        | indglobal 
------------------+-----------
 PRIMARY KEY (id) | t
(1 row)

-- ... so Odoo's GROUP BY id may select other columns of the table
SELECT so.id, so.name FROM sale_order so
GROUP BY so.id ORDER BY count(*) DESC, so.id LIMIT 2;
 id | name 
----+------
  1 | SO1
  2 | SO2
(2 rows)

-- ... and id is unique across partitions
INSERT INTO sale_order (id, name, partner_id, company_id, amount, create_date)
    VALUES (1, 'SO-dupid', 2, 1, 1, timestamp '2024-02-02');
ERROR:  duplicate key value violates unique constraint "sale_order_pkey"
DETAIL:  Key (id)=(1) already exists.
-- the batched data move filled the global index (index and heap agree)
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) AS via_global_pk FROM sale_order WHERE id > 0;
 via_global_pk 
---------------
          5003
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) AS via_heap FROM sale_order;
 via_heap 
----------
     5003
(1 row)

-- the incoming FK is backed by the global primary key
SELECT conindid::regclass FROM pg_constraint
WHERE conname = 'sale_order_line_order_id_fkey' AND conrelid = 'sale_order_line'::regclass;
    conindid     
-----------------
 sale_order_pkey
(1 row)

-- foreign key checks and writes by id find rows through the per-partition
-- index beside it, on every partition
SELECT (SELECT count(*) FROM pg_inherits WHERE inhparent = 'sale_order'::regclass) =
       (SELECT count(*) FROM pg_inherits WHERE inhparent = 'sale_order_pklocal'::regclass)
       AS every_partition_indexed;
 every_partition_indexed 
-------------------------
