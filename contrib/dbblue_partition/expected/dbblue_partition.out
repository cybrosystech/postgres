-- ---------------------------------------------------------------------
-- Publications: membership must move from the renamed backup to the new
-- parent on convert (else subscribers see the batched deletes), and undo
-- must restore membership without double-adding.
-- ---------------------------------------------------------------------
CREATE TABLE pub_t (id serial PRIMARY KEY, create_date timestamp NOT NULL);
INSERT INTO pub_t (create_date) VALUES (timestamp '2025-06-01');
CREATE PUBLICATION dbblue_test_pub FOR TABLE pub_t;
CALL dbblue_partition_model('pub_t');
WARNING:  table public.pub_t is part of a logical replication publication; moved rows will be re-published as inserts
HINT:  Consider publish_via_partition_root = true on the publication, and deduplicate on subscribers.
WARNING:  primary key of public.pub_t widens from (id) to (id, create_date): "id" is unique per partition only
DETAIL:  It cannot be a global index because the table is published for logical replication, and a unique index on a partitioned table must otherwise include the partition key. Odoo ids come from a sequence, so cross-partition duplicates do not occur in normal operation.
HINT:  Monitoring: SELECT id, count(*) FROM public.pub_t GROUP BY id HAVING count(*) > 1;
SELECT pr.prrelid::regclass::text AS published
FROM pg_publication_rel pr JOIN pg_publication p ON p.oid = pr.prpubid
WHERE p.pubname = 'dbblue_test_pub';
 published 
-----------
 pub_t
(1 row)

CALL dbblue_partition_undo('pub_t');
SELECT pr.prrelid::regclass::text AS published
FROM pg_publication_rel pr JOIN pg_publication p ON p.oid = pr.prpubid
WHERE p.pubname = 'dbblue_test_pub';
 published 
-----------
 pub_t
(1 row)

DROP PUBLICATION dbblue_test_pub;
-- ---------------------------------------------------------------------
-- A NOT VALID incoming FK (tolerating pre-existing violations) must stay
-- NOT VALID through both conversion and undo.
-- ---------------------------------------------------------------------
CREATE TABLE nv_parent (id serial PRIMARY KEY, create_date timestamp NOT NULL);
CREATE TABLE nv_child (id serial PRIMARY KEY, parent_id int);
INSERT INTO nv_parent (create_date) VALUES (timestamp '2025-06-01');
INSERT INTO nv_child (parent_id) VALUES (424242);	-- pre-existing violation
ALTER TABLE nv_child ADD CONSTRAINT nv_child_fk
    FOREIGN KEY (parent_id) REFERENCES nv_parent(id) NOT VALID;
CALL dbblue_partition_model('nv_parent');
SELECT convalidated FROM pg_constraint WHERE conname = 'nv_child_fk';
 convalidated 
--------------
 f
(1 row)

CALL dbblue_partition_undo('nv_parent');
SELECT convalidated FROM pg_constraint WHERE conname = 'nv_child_fk';
 convalidated 
--------------
 f
(1 row)

-- ---------------------------------------------------------------------
-- Single-transaction mode is atomic: a ROLLBACK undoes the conversion
-- ---------------------------------------------------------------------
CREATE TABLE atomic_t (id serial PRIMARY KEY, create_date timestamp NOT NULL);
INSERT INTO atomic_t (create_date)
    SELECT timestamp '2025-05-01' + g * interval '1 hour' FROM generate_series(1, 500) g;
BEGIN;
CALL dbblue_partition_model('atomic_t', p_single_transaction => true);
ROLLBACK;
SELECT relkind FROM pg_catalog.pg_class WHERE relname = 'atomic_t';
 relkind 
---------
 r
(1 row)

SELECT count(*) FROM atomic_t;
 count 
-------
   500
(1 row)

BEGIN;
CALL dbblue_partition_model('atomic_t', p_single_transaction => true);
COMMIT;
SELECT relkind FROM pg_catalog.pg_class WHERE relname = 'atomic_t';
 relkind 
---------
 p
(1 row)

SELECT count(*) FROM atomic_t;
 count 
-------
   500
(1 row)

-- ---------------------------------------------------------------------
-- 1.4 behaviour: a precision-qualified control column is accepted, the
-- default interval is 1 year, conversions are atomic by default, and a
-- dependent materialized view is carried across (recreated with its
-- index and refreshed only after the data has landed, so it holds the
-- same rows as before rather than an empty snapshot).
-- ---------------------------------------------------------------------
CREATE TABLE mv_t (id serial PRIMARY KEY, create_date timestamp(3) NOT NULL);
INSERT INTO mv_t (create_date)
    SELECT timestamp '2021-06-01' + (g || ' days')::interval
    FROM generate_series(1, 400) g;
CREATE MATERIALIZED VIEW mv_t_agg AS
    SELECT date_trunc('year', create_date) AS yr, count(*) AS n FROM mv_t GROUP BY 1;
CREATE INDEX mv_t_agg_yr ON mv_t_agg (yr);
COMMENT ON MATERIALIZED VIEW mv_t_agg IS 'per year';
CREATE MATERIALIZED VIEW mv_t_empty AS SELECT 1 AS x FROM mv_t WITH NO DATA;
CALL dbblue_partition_model('mv_t');
SELECT partition_interval FROM part_config WHERE parent_table = 'public.mv_t';
 partition_interval 
--------------------
 @ 1 year
(1 row)

SELECT count(*) FROM mv_t;
 count 
-------
   400
(1 row)

SELECT yr, n FROM mv_t_agg ORDER BY yr;                 -- must match pre-conversion
            yr            |  n  
--------------------------+-----
 Fri Jan 01 00:00:00 2021 | 213
 Sat Jan 01 00:00:00 2022 | 187
(2 rows)

SELECT relispopulated FROM pg_catalog.pg_class WHERE relname = 'mv_t_agg';
 relispopulated 
----------------
 t
(1 row)

SELECT relispopulated FROM pg_catalog.pg_class WHERE relname = 'mv_t_empty';
 relispopulated 
----------------
 f
(1 row)

SELECT indexname FROM pg_indexes WHERE tablename = 'mv_t_agg';
  indexname  
-------------
 mv_t_agg_yr
(1 row)

SELECT obj_description('mv_t_agg'::regclass, 'pg_class');
 obj_description 
-----------------
 per year
(1 row)

-- status reports the partition set's real size, not the parent's zero
SELECT state, total_size <> '0 bytes' AS size_reported, rows_not_visible_to_odoo
FROM dbblue_partition_status('mv_t');
  state   | size_reported | rows_not_visible_to_odoo 
----------+---------------+--------------------------
 complete | t             |                        0
(1 row)

-- ---------------------------------------------------------------------
-- 1.4 behaviour: undo reconciles column drift by itself when the backup
-- is empty, so a module update between conversion and undo is not an
-- obstacle; added values survive and generated columns recompute.
-- ---------------------------------------------------------------------
ALTER TABLE mv_t ADD COLUMN note text;
ALTER TABLE mv_t ADD COLUMN doubled numeric GENERATED ALWAYS AS (id * 2) STORED;
UPDATE mv_t SET note = 'kept' WHERE id <= 3;
CALL dbblue_partition_undo('mv_t');
SELECT relkind FROM pg_catalog.pg_class WHERE relname = 'mv_t';
 relkind 
---------
 r
(1 row)

SELECT count(*) AS rows, count(*) FILTER (WHERE note = 'kept') AS kept FROM mv_t;
 rows | kept 
------+------
  400 |    3
(1 row)

SELECT doubled FROM mv_t WHERE id = 3;
 doubled 
---------
       6
(1 row)

SELECT count(*) FROM mv_t_agg;                          -- matview survived the undo
 count 
-------
     2
(1 row)

DROP MATERIALIZED VIEW mv_t_agg, mv_t_empty;
DROP TABLE mv_t;
-- ---------------------------------------------------------------------
-- 1.2: dbblue_partition_estimate predicts a conversion without changing
-- anything.  Timings vary by machine; the shape of the work does not.
-- ---------------------------------------------------------------------
CREATE TABLE est_t (id serial PRIMARY KEY, v text UNIQUE, create_date timestamp NOT NULL);
CREATE TABLE est_child (id serial PRIMARY KEY, t_id int REFERENCES est_t (id));
INSERT INTO est_t (v, create_date)
    SELECT 'v' || g, timestamp '2021-01-01' + (g || ' days')::interval
    FROM generate_series(1, 1000) g;
INSERT INTO est_child (t_id) SELECT g FROM generate_series(1, 1000) g;
ANALYZE est_t, est_child;
SET max_parallel_workers_per_gather = 3;
SELECT table_name, index_count, partition_count > 4 AS covers_data_and_premake,
       batch_count, control_indexed, fks_to_validate,
       estimated_seconds > 0 AS positive,
       estimated_seconds_high >= estimated_seconds AS high_not_below,
       table_locked_seconds = estimated_seconds AS locked_throughout,
       breakdown ?& array['structural_swap', 'data_move', 'batch_scans',
                          'row_count_checks', 'fk_validation', 'analyze'] AS all_phases,
       (breakdown -> 'measured' ->> 'sampled_rows')::int AS sampled_rows,
       notes
FROM dbblue_partition_estimate('est.t');
  table_name  | index_count | covers_data_and_premake | batch_count | control_indexed | fks_to_validate | positive | high_not_below | locked_throughout | all_phases | sampled_rows |                                                                           notes                                                                            
--------------+-------------+-------------------------+-------------+-----------------+-----------------+----------+----------------+-------------------+------------+--------------+------------------------------------------------------------------------------------------------------------------------------------------------------------
 public.est_t |           2 | t                       |           4 | f               |               1 | t        | t              | t                 | t          |         1000 | {"no index leads on \"create_date\": every batch starts with a full scan for min(create_date); CREATE INDEX CONCURRENTLY on it first to remove that cost"}
(1 row)

-- batched mode holds the lock only for the structural swap
SELECT table_locked_seconds < estimated_seconds AS lock_released_early
FROM dbblue_partition_estimate('est_t', p_single_transaction => false);
 lock_released_early 
---------------------
 t
(1 row)

-- an index on the control column removes the per-batch min() scan
CREATE INDEX est_t_create_date ON est_t (create_date);
SELECT control_indexed, batch_count, notes
FROM dbblue_partition_estimate('est_t', p_sample_rows => 100);
 control_indexed | batch_count | notes 
-----------------+-------------+-------
 t               |           4 | {}
(1 row)

-- nothing persists, the caller's settings survive, and an enclosing
-- transaction carries on
BEGIN;
SELECT estimated_seconds > 0 AS positive FROM dbblue_partition_estimate('est_t');
 positive 
----------
 t
(1 row)

SELECT count(*) AS scratch_left FROM pg_class WHERE relname LIKE 'dbblue\_est\_%';
 scratch_left 
--------------
            0
(1 row)

COMMIT;
SHOW max_parallel_workers_per_gather;
 max_parallel_workers_per_gather 
---------------------------------
 3
(1 row)

RESET max_parallel_workers_per_gather;
SELECT count(*) AS cataloged FROM dbblue_partition_catalog WHERE parent_table = 'est_t';
 cataloged 
-----------
         0
(1 row)

SELECT estimated_seconds FROM dbblue_partition_estimate('no_such_table');
ERROR:  table public.no_such_table does not exist
SELECT estimated_seconds FROM dbblue_partition_estimate('est_t', 'v');	-- wrong type
ERROR:  column "v" has type text, but range partitioning needs date, timestamp or timestamptz
CALL dbblue_partition_model('est_t');
WARNING:  unique constraint/index "est_t_v_key" on (v) does not include "create_date": it will be enforced per partition, not globally
DETAIL:  PostgreSQL requires every global unique index on a partitioned table to include the partition key.
SELECT estimated_seconds FROM dbblue_partition_estimate('est_t');	-- already converted
ERROR:  table public.est_t is already partitioned
DROP TABLE est_child, est_t, est_t_old;
DROP TABLE dbblue_tpl_est_t;
\set SHOW_CONTEXT errors
