SET enable_seqscan = off;
EXPLAIN (COSTS OFF)
SELECT 1 FROM sale_order x
WHERE id = 7 AND create_date >= '2025-01-01' AND create_date < '2025-01-02'
FOR KEY SHARE OF x;
