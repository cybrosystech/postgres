-- Tests for dbblue_partition.  Every scenario here corresponds to a defect
-- of the retired contrib/dbblue_partition C implementation or to a promise
-- in the extension's documentation.  All row dates are fixed so that error
-- messages naming leaf partitions stay stable; "today" tests only check
-- that statements succeed.
CREATE EXTENSION dbblue_partition CASCADE;
NOTICE:  installing required extension "pg_partman"
SET client_min_messages = warning;
SET timezone = 'UTC';
-- Refuses to run until explicitly enabled (off by default)
CALL dbblue_partition_model('anything');
ERROR:  dbblue_partition is disabled
HINT:  Run SET dbblue_partition.enabled = on; to enable it for this session.
CONTEXT:  PL/pgSQL function public.dbblue_partition_enabled_check() line 4 at RAISE
SQL statement "SELECT public.dbblue_partition_enabled_check()"
PL/pgSQL function dbblue_partition_model(text,text,text,text,integer,interval,boolean,boolean,boolean) line 24 at PERFORM
SET dbblue_partition.enabled = on;
-- ---------------------------------------------------------------------
-- Validation: fail early, before touching anything
-- ---------------------------------------------------------------------
CALL dbblue_partition_model('no_such_table');
ERROR:  table public.no_such_table does not exist
CONTEXT:  PL/pgSQL function public.dbblue_partition_convert(name,name,name,text,integer) line 83 at RAISE
