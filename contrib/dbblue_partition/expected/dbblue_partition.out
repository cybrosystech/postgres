-- ---------------------------------------------------------------------
-- Empty table: zero partitions was an unwritable-table defect
-- ---------------------------------------------------------------------
CREATE TABLE empty_model (id serial PRIMARY KEY, create_date timestamp NOT NULL DEFAULT now());
CALL dbblue_partition_model('empty_model');
WARNING:  primary key of public.empty_model widens from (id) to (id, create_date): "id" is unique per partition only
DETAIL:  A unique index on a partitioned table must include the partition key. Odoo ids come from a sequence, so cross-partition duplicates do not occur in normal operation.
HINT:  Monitoring: SELECT id, count(*) FROM public.empty_model GROUP BY id HAVING count(*) > 1;
INSERT INTO empty_model (create_date) VALUES (now());
INSERT INTO empty_model (create_date) VALUES (timestamp '1999-01-01');
SELECT count(*) FROM empty_model;
 count 
-------
     2
(1 row)

