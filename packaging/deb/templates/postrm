#!/bin/sh
set -e

case "$1" in
  purge)
    if [ -d /run/systemd/system ]; then
      systemctl disable dbblue.service || true
    fi
    # NOTE: the database cluster in /var/lib/dbblue is deliberately NOT deleted
    # on purge, to avoid accidental data loss. Remove it manually if intended:
    #   sudo rm -rf /var/lib/dbblue
    ;;
esac

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi

exit 0
