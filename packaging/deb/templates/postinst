#!/bin/sh
set -e

DBUSER=dbblue

case "$1" in
  configure)
    # 1. system user to own the clusters + run the servers
    if ! getent passwd "$DBUSER" >/dev/null; then
      adduser --system --group --home /var/lib/dbblue --shell /bin/bash \
              --gecos "DBblue PostgreSQL" "$DBUSER"
    fi
    mkdir -p /var/lib/dbblue/clusters /var/log/dbblue
    chown "$DBUSER:$DBUSER" /var/lib/dbblue /var/lib/dbblue/clusters /var/log/dbblue
    chmod 750 /var/lib/dbblue/clusters /var/log/dbblue

    # 2. make the template service known
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi

    # 3. create the default 'main' cluster on first install
    #    (dbblue-createcluster handles initdb + free port + config + start)
    if [ ! -e /var/lib/dbblue/clusters/main/PG_VERSION ]; then
      if ! dbblue-createcluster main; then
        echo "DBblue: automatic 'main' cluster creation failed;"
        echo "       run it manually with:  sudo dbblue-createcluster main"
      fi
    fi
    ;;
esac

exit 0
