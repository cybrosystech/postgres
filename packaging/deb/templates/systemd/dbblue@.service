[Unit]
Description=DBblue PostgreSQL 19 cluster %i (Odoo-tuned)
Documentation=https://github.com/cybrosystech/postgres
After=network.target

[Service]
Type=simple
User=dbblue
Group=dbblue
Environment=PGDATA=/var/lib/dbblue/clusters/%i
# Not built with --with-systemd, so postgres runs directly (no sd_notify).
ExecStart=/opt/dbblue/19/bin/postgres -D /var/lib/dbblue/clusters/%i
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=120
Restart=on-failure
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
