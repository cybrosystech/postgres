#!/bin/sh
# dbblue-psql — connect to DBblue on whatever port/socket it uses, as the
# dbblue superuser. Extra args are passed through to psql.
#   sudo dbblue-psql                 # opens the postgres database
#   sudo dbblue-psql -d mydb -c '\l'
set -e

D=/var/lib/dbblue/19/data
B=/opt/dbblue/19/bin

if [ ! -s "$D/PG_VERSION" ]; then
  echo "DBblue: no cluster found at $D"
  exit 1
fi

PORT="$(sudo -u dbblue "$B/postgres" -D "$D" -C port 2>/dev/null)"
[ -n "$PORT" ] || PORT=5432
SOCK="$(sudo -u dbblue "$B/postgres" -D "$D" -C unix_socket_directories 2>/dev/null | cut -d, -f1 | tr -d ' ')"
[ -n "$SOCK" ] || SOCK=/tmp

exec sudo -u dbblue "$B/psql" -h "$SOCK" -p "$PORT" -d "${PGDATABASE:-postgres}" "$@"
