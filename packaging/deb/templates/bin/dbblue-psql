#!/bin/sh
# dbblue-psql [CLUSTER] [psql args...]
# Connect to a DBblue cluster as the dbblue superuser (default cluster: main).
#   sudo dbblue-psql                      # connect to 'main'
#   sudo dbblue-psql test                 # connect to cluster 'test'
#   sudo dbblue-psql main -c '\l'         # pass args through to psql
set -e

BIN=/opt/dbblue/19/bin
CLUSTERS=/var/lib/dbblue/clusters

# needs root to reach the dbblue-owned cluster + connect as the dbblue role
if [ "$(id -u)" -ne 0 ]; then echo "run with sudo: sudo dbblue-psql [cluster]"; exit 1; fi

# First arg is a cluster name only if it matches an existing cluster; else default 'main'.
CLUSTER=main
if [ -n "$1" ] && [ -e "$CLUSTERS/$1/PG_VERSION" ]; then CLUSTER="$1"; shift; fi

DATA="$CLUSTERS/$CLUSTER"
if [ ! -e "$DATA/PG_VERSION" ]; then
  echo "no DBblue cluster '$CLUSTER' at $DATA (see: sudo dbblue-lsclusters)"; exit 1
fi

PORT="$(sudo -u dbblue "$BIN/postgres" -D "$DATA" -C port 2>/dev/null)"; [ -n "$PORT" ] || PORT=5432
SOCK="$(sudo -u dbblue "$BIN/postgres" -D "$DATA" -C unix_socket_directories 2>/dev/null | cut -d, -f1 | tr -d ' ')"
[ -n "$SOCK" ] || SOCK=/tmp

exec sudo -u dbblue "$BIN/psql" -h "$SOCK" -p "$PORT" -d "${PGDATABASE:-postgres}" "$@"
