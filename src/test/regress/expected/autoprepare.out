-- a changed table that still matches (index added, statistics refreshed)
-- keeps its entry: nothing is dropped
CREATE INDEX aprep_stale_id ON aprep_stale (id);
ANALYZE aprep_stale;
SELECT v FROM aprep_stale WHERE id = 8;
  v  
