REFRESH MATERIALIZED VIEW mvs_mvcat;              -- system catalog
DEBUG:  matview "mvs_mvcat": not skipped: source is a system catalog
CREATE TABLE mvs_bump_a(id int);
REFRESH MATERIALIZED VIEW mvs_mvcat;              -- system catalog
DEBUG:  matview "mvs_mvcat": not skipped: source is a system catalog
SELECT c FROM mvs_mvcat;
 c 
