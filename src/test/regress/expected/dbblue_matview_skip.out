SELECT 'CREATE MATERIALIZED VIEW mvs_mvmany WITH (auto_skip_unchanged=true) AS SELECT '
       || string_agg(format('(SELECT count(*) FROM mvs_many_%s) AS c%s', g, g), ', ')
  FROM generate_series(1, 40) g \gexec
